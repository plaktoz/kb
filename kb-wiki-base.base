views:
  - type: table
    name: Table
    filters:
      and:
        - '!file.inFolder("raw/processed")'
        - '!file.folder.contains("asset")'
    order:
      - file.name
      - author
      - file.folder
      - source_url
      - file.ctime
      - tags
    sort:
      - property: file.ctime
        direction: DESC
